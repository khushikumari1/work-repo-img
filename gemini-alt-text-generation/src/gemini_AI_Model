# ─────────────────────────────────────────────────────────────────────────────


class GeminiImageProcessor:
    def __init__(self):
        self.max_retries = 3
        self.base_delay = 1

        # ── Build the LangChain chain once at init time ──────────────────────
        #
        # 1. Model — wraps Gemini via the Google Generative AI LangChain integration.
        #    We use gemini-2.5-flash-image which supports vision inputs.
        #    temperature=0.1 for consistent, deterministic output.
        #    max_output_tokens=16384 for long descriptions.
        #    max_retries is handled by LangChain internally (uses tenacity).
        #    response_mime_type ensures JSON output format.
        self.llm = ChatGoogleGenerativeAI(
            model=GEMINI_MODEL,
            temperature=0.1,
            max_output_tokens=16384,
            max_retries=self.max_retries,
            credentials=credentials,
            project=credentials.project_id,
            location=GCP_LOCATION,
            response_mime_type="application/json",
        )

        # 2. Output parser — replaces your manual parse_json_response().
        #    JsonOutputParser strips ```json fences and calls json.loads() for you.
        self.parser = JsonOutputParser()

        # 3. Prompt template — replaces the raw f-string formatting.
        #    We build the full text prompt here; the image bytes are injected
        #    separately inside build_messages() because LangChain sends vision
        #    data as a HumanMessage with mixed content parts.
        self.prompt_template = ChatPromptTemplate.from_messages([
            ("human", "{full_prompt}")   # image is added as a content part below
        ])

        # 4. LCEL chain: prompt | model | parser
        #    Chain is built but bypassed for actual invocation - we call llm.invoke() 
        #    directly to cleanly inject image bytes. Parser is still applied manually.
        self.chain = self.prompt_template | self.llm | self.parser

        self.log_message("LangChain model initialized with temperature=0.1, JSON output enforced")

    # ──────────────────────────────────────────────────────────────────────────
    # CAPTION INSTRUCTION  (unchanged from your original)
    # ──────────────────────────────────────────────────────────────────────────
    def create_caption_instruction(self, caption: str) -> str:
        if caption:
            return (
                f'\n**IMAGE CAPTION CONTEXT:**\n'
                f'The image has the following caption: "{caption}"\n\n'
                f'Use this caption as reference material. Do NOT repeat the caption verbatim.\n'
            )
        return "**No caption provided for this image.**"

    # ──────────────────────────────────────────────────────────────────────────
    # LOGGING  (unchanged)
    # ──────────────────────────────────────────────────────────────────────────
    def log_message(self, message: str) -> None:
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        entry = f"[{timestamp}] {message}"
        print(entry)
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(entry + "\n")

    # ──────────────────────────────────────────────────────────────────────────
    # BUILD LANGCHAIN MESSAGE WITH IMAGE
    #
    # LangChain's ChatGoogleGenerativeAI accepts vision inputs via a
    # HumanMessage whose content is a list of dicts — one dict for the text
    # prompt and one for the base64-encoded image.  We bypass the
    # ChatPromptTemplate for the final invoke and build the message manually
    # so we can attach the image bytes cleanly.
    # ──────────────────────────────────────────────────────────────────────────
    def build_human_message(self, image_path: str, full_prompt: str) -> HumanMessage:
        """Return a HumanMessage containing the prompt text + base64 image."""
        with open(image_path, "rb") as f:
            image_bytes = f.read()

        mime_type = self._get_mime_type(image_path)
        image_b64 = base64.b64encode(image_bytes).decode("utf-8")

        # LangChain multimodal content format for Google GenAI
        content = [
            {"type": "text", "text": full_prompt},
            {
                "type": "image_url",
                "image_url": {
                    "url": f"data:{mime_type};base64,{image_b64}"
                },
            },
        ]
        return HumanMessage(content=content)

    # ──────────────────────────────────────────────────────────────────────────
    # CALL GEMINI VIA LANGCHAIN  (replaces call_gemini_single_prompt)
    #
    # We call self.llm directly with the pre-built HumanMessage instead of
    # going through the chain, because the chain's prompt step would try to
    # render the template again.  The parser step is still applied manually.
    # This keeps the image-injection clean while still using the LangChain
    # model wrapper (retry logic, callbacks, LangSmith tracing all active).
    # ──────────────────────────────────────────────────────────────────────────
    def call_gemini_via_langchain(self, image_path: str, full_prompt: str) -> dict:
        message = self.build_human_message(image_path, full_prompt)
        response = self.llm.invoke([message])

        text = self._response_text(response)
        self.log_message(f"LangChain raw response (first 200 chars): {text[:200]}")
        return self.parser.parse(text)

    @staticmethod
    def _response_text(response) -> str:
        """Gemini 3.x returns content as a list of blocks; join the text parts."""
        c = response.content
        if isinstance(c, str):
            return c
        return "".join(
            p if isinstance(p, str) else p.get("text", "")
            for p in c
            if isinstance(p, str) or (isinstance(p, dict) and p.get("type") == "text")
        )
    # ──────────────────────────────────────────────────────────────────────────
    # MIME TYPE HELPER  (unchanged)
    # ──────────────────────────────────────────────────────────────────────────
    def _get_mime_type(self, image_path: str) -> str:
        ext = image_path.lower().rsplit(".", 1)[-1]
        return {
            "png": "image/png",
            "jpg": "image/jpeg",
            "jpeg": "image/jpeg",
            "bmp": "image/bmp",
            "tiff": "image/tiff",
        }.get(ext, "image/jpeg")

    # ──────────────────────────────────────────────────────────────────────────
    # POST-PROCESSOR: Fix flowchart terminal endpoints
    # ──────────────────────────────────────────────────────────────────────────
    def fix_flowchart_terminal_endpoints(self, long_alt_text: str, short_alt_text: str) -> str:
        """
        Post-process flowchart descriptions to add missing 'terminal endpoint' phrases.
        
        Gemini consistently ignores prompts about terminal endpoints, so we fix them here.
        
        Strategy:
        1. Find all boxes that arrows "point to" or "lead to"
        2. Check if those boxes have arrows going OUT (continuation detected)
        3. If NO continuation, add "which is a terminal endpoint"
        """
        # Check if this is a flowchart
        combined_text = (short_alt_text + " " + long_alt_text).lower()
        if "flowchart" not in combined_text:
            return long_alt_text 
        
        # Already has terminal endpoint phrases
        if "terminal endpoint" in long_alt_text.lower() or "terminates" in long_alt_text.lower():
            return long_alt_text
        
        import re
        
        # Split by sentences (on ". " not just ".")
        sentences = long_alt_text.split('. ')
        fixed_sentences = []
        
        # Pattern for boxes that arrows point TO (made more flexible)
        destination_box_pattern = (
            r'(?:point[s]?(?:ing)?|lead[s]?|connect[s]?)\s+to\s+'
            r'(?:a\s+|the\s+)?(?:text\s+)?(?:box|rectangle|node)'
        )
        
        # Patterns indicating a box has arrows going OUT (not a terminal)
        outgoing_arrow_patterns = [
            r'arrows?\s+(?:extend[s]?|emerge[s]?|branch[es]?|exit[s]?)\s+(?:from|downward|upward)',
            r'from\s+(?:this|the|that)\s+(?:box|node|rectangle)',
        ]
        
        for i, sentence in enumerate(sentences):
            sentence_lower = sentence.lower()
            
            # Does this sentence describe a box as a destination?
            if re.search(destination_box_pattern, sentence_lower):
                # This is a destination box - check if it has continuations
                
                has_outgoing = False
                
                # Look in IMMEDIATE next sentence only (more accurate)
                if i + 1 < len(sentences):
                    next_sent = sentences[i + 1].lower()
                    
                    # Skip if next sentence is the ending phrase
                    if "alt text provided" in next_sent:
                        # This is the last real sentence, so it's a terminal endpoint
                        has_outgoing = False
                    else:
                        # Check if next sentence describes arrows FROM this box
                        for pattern in outgoing_arrow_patterns:
                            if re.search(pattern, next_sent):
                                has_outgoing = True
                                break
                else:
                    # No next sentence = terminal endpoint
                    has_outgoing = False
                
                # If no outgoing arrows found, this is a terminal endpoint
                if not has_outgoing and "terminal endpoint" not in sentence_lower:
                    # Add terminal endpoint phrase
                    if sentence.endswith('.'):
                        sentence = sentence[:-1] + ", which is a terminal endpoint."
                    else:
                        sentence = sentence + ", which is a terminal endpoint"
            
            fixed_sentences.append(sentence)
        
        # Reconstruct
        fixed_text = '. '.join(fixed_sentences)
        fixed_text = fixed_text.replace('..', '.')
        fixed_text = re.sub(r'\s+', ' ', fixed_text)
        
        return fixed_text

